# ===========================================================================
# .env.example — MODELO do arquivo de segredos.
# Este arquivo VAI para o Git (nao tem segredo de verdade aqui dentro).
# Para usar: copie para ".env" e preencha os valores reais.
#   Windows PowerShell:  Copy-Item .env.example .env
# ===========================================================================

# --- AMBIENTE -------------------------------------------------------------
# "development" = seu PC (erros detalhados na tela, cookie funciona em http)
# "production"  = PythonAnywhere (erros escondidos, cookie so em https)
APP_ENV=development

# --- CHAVE SECRETA DO FLASK ----------------------------------------------
# Assina os cookies de sessao. Se vazar, alguem pode forjar um login.
# Gere a sua com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole-aqui-uma-chave-aleatoria-de-64-caracteres

# --- TOKEN DO FORMULARIO PUBLICO -----------------------------------------
# Faz parte da URL publica: /cadastro/<TOKEN>
# Se o link vazar ou comecar a receber spam, troque este valor e o link
# antigo morre na hora — sem mexer em uma linha de codigo.
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(24))"
CADASTRO_TOKEN=cole-aqui-um-token-aleatorio

# --- BANCO DE DADOS -------------------------------------------------------
# Vazio = usa o SQLite em instance/adba.db (o padrao).
# Preencher permite trocar para PostgreSQL no futuro SEM alterar codigo.
DATABASE_URL=

# --- USUARIO ADMIN INICIAL -----------------------------------------------
# Usado uma unica vez pelo comando "flask criar-admin" (Etapa 2).
ADMIN_NOME=Administrador
ADMIN_LOGIN=admin
ADMIN_SENHA_INICIAL=troque-esta-senha

# --- LIMITES DE ENVIO (opcional) -----------------------------------------
# Quantos cadastros o formulario publico aceita do MESMO IP.
# ATENCAO: no Wi-Fi da igreja todo mundo sai pelo mesmo IP, entao este numero
# vale para a igreja inteira, nao por pessoa.
# Deixe em branco para usar o padrao: 30 por hora e 100 por dia.
LIMITE_CADASTRO_PUBLICO=

# Tentativas de login erradas por IP. Quem ACERTA a senha nao gasta tentativa.
# Padrao: 5 per 15 minutes
LIMITE_LOGIN=

# --- PREFIXO DO ENDERECO (opcional) --------------------------------------
# Vazio = o sistema mora na RAIZ do dominio (https://site.com/).
#
# Preencha quando o sistema dividir o dominio com outros. No PythonAnywhere
# desta conta e exatamente o caso: um endereco, tres sistemas, cada um sob um
# caminho -> /demandas, /fechamento e /adba.
#
# ATENCAO: este valor tem que ser IDENTICO ao prefixo usado no arquivo WSGI
# (ver deploy/bloco_wsgi_adba.py). Ele define o PATH do cookie de sessao.
# Errado, o login falha EM SILENCIO: o navegador guarda o cookie e nunca o
# devolve, e a tela de login reaparece sem mensagem de erro nenhuma.
#
# O script anexar-wsgi.sh grava este campo sozinho.
URL_PREFIXO=
